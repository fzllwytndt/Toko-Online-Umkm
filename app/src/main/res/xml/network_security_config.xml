<?xml version="1.0" encoding="utf-8"?>
<!--
    Backend REST API dijalankan secara lokal memakai HTTP biasa (bukan HTTPS).
    Android memblokir HTTP sejak Android 9, jadi izin dibuka hanya untuk alamat
    pengembangan di bawah ini. Alamat selain yang terdaftar tetap wajib HTTPS.

    10.0.2.2       = alamat komputer host kalau aplikasi dijalankan di Android Emulator
    localhost      = kalau backend diakses dari perangkat itu sendiri
    192.168.18.51  = contoh IP lokal komputer, dipakai untuk HP Android fisik atau
                     emulator yang tidak bisa memakai 10.0.2.2.
                     Ganti dengan IP komputer sendiri (lihat dengan perintah ipconfig).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">192.168.18.51</domain>
    </domain-config>
</network-security-config>
