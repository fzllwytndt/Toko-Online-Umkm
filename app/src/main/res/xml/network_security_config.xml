<?xml version="1.0" encoding="utf-8"?>
<!--
    Backend REST API dijalankan secara lokal memakai HTTP biasa (bukan HTTPS).
    Android memblokir HTTP sejak Android 9, jadi izin dibuka hanya untuk alamat
    pengembangan di bawah ini. Alamat selain yang terdaftar tetap wajib HTTPS.

    10.0.2.2  = alamat komputer host kalau aplikasi dijalankan di Android Emulator
    localhost
    127.0.0.1 = kalau backend diakses dari perangkat itu sendiri

    IP lokal komputer (misalnya 192.168.1.5 untuk HP Android fisik) sengaja TIDAK
    didaftarkan di sini, karena nilainya berbeda pada tiap komputer dan berubah
    setiap ganti jaringan. Untuk keperluan itu dipakai berkas khusus build debug
    pada app/src/debug/res/xml/network_security_config.xml, yang mengizinkan HTTP
    ke alamat mana pun selama masih build debug. Jadi cukup mengatur server.url
    pada local.properties, tanpa perlu menyentuh berkas ini lagi.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
