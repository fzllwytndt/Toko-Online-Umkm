<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.TokoOnlineUmkm" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorError">@color/red_error</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
    <style name="Theme.TokoOnlineUmkm" parent="Base.Theme.TokoOnlineUmkm" />
    <style name="Theme.TokoOnlineUmkm.Splash" parent="Theme.TokoOnlineUmkm">
        <item name="android:windowBackground">@color/green_dark</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/green_dark</item>
    </style>
    <style name="EzpickInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/green_field</item>
        <item name="boxStrokeColor">@color/ezpick_box_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="hintEnabled">false</item>
        <item name="startIconTint">@color/green_primary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeEzpickInput</item>
        <item name="errorTextColor">@color/red_error</item>
    </style>
    <style name="ShapeEzpickInput" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="EzpickButton" parent="Widget.Material3.Button">
        <item name="android:layout_height">52dp</item>
        <item name="backgroundTint">@color/ezpick_button_bg</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">26dp</item>
    </style>
    <!-- Tombol kecil untuk menambah/mengurangi jumlah item pada keranjang. -->
    <style name="EzpickButtonKecil" parent="Widget.Material3.Button">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/green_primary</item>
        <item name="backgroundTint">@color/green_soft</item>
        <item name="cornerRadius">12dp</item>
        <item name="elevation">0dp</item>
    </style>
    <!-- Bentuk latar menu Bottom Navigation yang sedang aktif. -->
    <style name="EzpickBottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/green_soft</item>
    </style>
</resources>