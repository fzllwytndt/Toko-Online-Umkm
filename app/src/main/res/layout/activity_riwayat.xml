<?xml version="1.0" encoding="utf-8"?>
<!--
    Wadah halaman Riwayat Pesanan. Dibuka dari halaman Profil karena pada desain baru
    Bottom Navigation hanya berisi Beranda, Rekomendasi, Keranjang, dan Profil.
    Isi halamannya tetap memakai HistoryFragment yang sudah ada.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.history.HistoryActivity">

    <include
        android:id="@+id/barKembali"
        layout="@layout/layout_bar_kembali"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/wadahFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barKembali"
        tools:layout="@layout/fragment_riwayat" />

</androidx.constraintlayout.widget.ConstraintLayout>
