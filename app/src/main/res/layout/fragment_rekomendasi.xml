<?xml version="1.0" encoding="utf-8"?>
<!--
    Halaman 05 - Rekomendasi. Dua bagian sesuai gambar referensi:
    "Best Seller" (GET /api/products?best_seller=1) dan "Harga Terjangkau"
    (menu termurah yang diurutkan dari data GET /api/products).

    Catatan tata letak:
    - Bar atas tetap di tempatnya, isi di bawahnya dibungkus NestedScrollView
      supaya seluruh halaman bisa digulir atas-bawah.
    - Kedua daftar menu digulir ke samping. Padding kiri-kanan dipasang pada
      RecyclerView-nya sendiri (bukan pada induk) dengan clipToPadding="false",
      supaya kartunya bisa digeser sampai mentok tepi layar.
    - Lebar kartu diatur dari RecommendationFragment, karena item_produk.xml
      memakai match_parent yang hanya cocok untuk daftar 2 kolom.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.recommendation.RecommendationFragment">

    <include
        android:id="@+id/barAtas"
        layout="@layout/layout_bar_atas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollRekomendasi"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barAtas">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvBanner"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:background="@color/green_dark"
                android:gravity="center"
                android:text="@string/rekomendasi_banner"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/rekomendasi_best_seller"
                    android:src="@drawable/ic_star"
                    app:tint="@color/text_dark" />

                <TextView
                    style="@style/EzpickJudulBagian"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/rekomendasi_best_seller" />
            </LinearLayout>

            <!-- Digulir ke samping: LinearLayoutManager horizontal dipasang di
                 RecommendationFragment. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBestSeller"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:overScrollMode="ifContentScrolls"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:scrollbars="none"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_produk" />

            <TextView
                android:id="@+id/tvBestSellerKosong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:text="@string/rekomendasi_best_seller_kosong"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/rekomendasi_harga_terjangkau"
                    android:src="@drawable/ic_tag"
                    app:tint="@color/text_dark" />

                <TextView
                    style="@style/EzpickJudulBagian"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/rekomendasi_harga_terjangkau" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTerjangkau"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:overScrollMode="ifContentScrolls"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:scrollbars="none"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_produk" />

            <TextView
                android:id="@+id/tvTerjangkauKosong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:text="@string/rekomendasi_terjangkau_kosong"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:contentDescription="@string/desc_loading"
                android:indeterminateTint="@color/green_primary"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvPesan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Data gagal dimuat."
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCobaLagi"
                style="@style/EzpickButton"
                android:layout_width="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="@string/button_coba_lagi"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
