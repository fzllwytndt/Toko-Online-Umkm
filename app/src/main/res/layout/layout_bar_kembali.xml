<?xml version="1.0" encoding="utf-8"?>
<!--
    Bar atas bertombol kembali, mengikuti gambar referensi halaman kategori.
    Dipakai bersama oleh halaman Kategori, Detail Menu, dan Riwayat Pesanan.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/btnKembali"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_circle_soft"
        android:contentDescription="@string/desc_kembali"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvJudulBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_dark"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnKembali"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Beranda / Promo Spesial" />

</androidx.constraintlayout.widget.ConstraintLayout>
