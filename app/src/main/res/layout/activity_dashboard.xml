<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard : halaman tujuan setelah Login berhasil -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green_soft"
    android:fillViewport="true"
    tools:context=".ui.dashboard.DashboardActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="56dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/bg_logo_green"
            android:gravity="center"
            android:text="@string/app_logo"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/dashboard_title"
                android:textColor="@color/text_dark"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:text="@string/dashboard_welcome"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <!-- Nama pengguna yang diambil dari sesi SharedPreferences -->
            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:textColor="@color/green_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="faizal" />

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                tools:text="faizal@example.com" />

            <TextView
                android:id="@+id/tvNoTlp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                tools:text="081234567890" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/EzpickButton"
                android:layout_width="match_parent"
                android:layout_marginTop="24dp"
                android:text="@string/button_logout" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
