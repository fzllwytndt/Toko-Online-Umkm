# Konfigurasi koneksi MySQL.
# Salin file ini menjadi .env lalu isi sesuai pengaturan MySQL di komputer sendiri.
# File .env tidak ikut diunggah ke GitHub (lihat .gitignore).

DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_toko_online
DB_USER=root
DB_PASSWORD=

# Port tempat backend dijalankan.
APP_PORT=3000
